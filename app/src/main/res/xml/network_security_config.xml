<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted AI models (Ollama, LM Studio …) are often reached via plain http in the home network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
